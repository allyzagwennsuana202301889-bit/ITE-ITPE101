
{
  "info": {
    "name": "Artistry API v1 - ITPE101",
    "description": "Postman API testing collection. Run against the local TEST database only. Configure credentials in the environment. Never store real passwords or tokens in this collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "productId", "value": "1" },
    { "key": "tabletId", "value": "1" },
    { "key": "orderId", "value": "1" },
    { "key": "artKitId", "value": "1" },
    { "key": "couponId", "value": "1" },
    { "key": "categoryId", "value": "1" }
  ],
  "item": [
    {
      "name": "01 - Authentication",
      "item": [
        {
          "name": "API Welcome",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('API responds successfully', () => pm.response.to.have.status(200));",
                "pm.test('API version is v1', () => pm.expect(pm.response.json().version).to.eql('v1'));"
              ]
            }
          }]
        },
        {
          "name": "Register Customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Test Customer\",\n  \"email\": \"postman-{{$timestamp}}@example.test\",\n  \"password\": \"PostmanTest123!\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/register"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Registration is accepted', () => pm.expect([201, 409]).to.include(pm.response.code));",
                "if (pm.response.code === 201) {",
                "  const data = pm.response.json();",
                "  if (data.token) pm.environment.set('customerToken', data.token);",
                "}"
              ]
            }
          }]
        },
        {
          "name": "Customer Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Customer login succeeds', () => pm.response.to.have.status(200));",
                "const data = pm.response.json();",
                "pm.test('Token is returned', () => pm.expect(data.token).to.be.a('string').and.not.empty);",
                "if (data.token) pm.environment.set('customerToken', data.token);"
              ]
            }
          }]
        },
        {
          "name": "Get Current Customer",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": "{{baseUrl}}/api/v1/auth/me"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Current user is returned', () => pm.response.to.have.status(200));",
                "pm.test('User information exists', () => pm.expect(pm.response.json().user).to.have.property('email'));"
              ]
            }
          }]
        },
        {
          "name": "Reject Invalid Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"invalid@example.com\",\n  \"password\": \"WrongPassword123!\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Invalid login is rejected', () => pm.response.to.have.status(401));"
              ]
            }
          }]
        }
      ]
    },
    {
      "name": "02 - Public Catalog",
